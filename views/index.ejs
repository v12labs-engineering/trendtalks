<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f8fc">
  <meta name="description" content="Explore trending open-source repositories and the conversations shaping them.">
  <title>Discover · TrendTalks</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="stylesheet" href="/vendor/phosphor/regular/style.css">
  <link rel="stylesheet" href="/vendor/phosphor/fill/style.css">
  <link rel="stylesheet" href="/stylesheets/tokens.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="<%= captureMode ? "capture-mode" : "" %>">
  <div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
      <a class="brand" href="/" aria-label="TrendTalks home">
        <span>Trend</span><strong>talks</strong>
      </a>

      <nav class="primary-nav">
        <a class="nav-item is-active" href="#discover" aria-current="page"><i class="ph-fill ph-rocket-launch" aria-hidden="true"></i><span>Discover</span></a>
        <button class="nav-item" type="button" data-nav-watchlist><i class="ph ph-star" aria-hidden="true"></i><span>Watchlist</span><span class="nav-count" data-watch-count>0</span></button>
        <button class="nav-item" type="button" data-nav-compare><i class="ph ph-columns" aria-hidden="true"></i><span>Compare</span></button>
        <button class="nav-item" type="button" data-nav-digests><i class="ph ph-envelope-simple" aria-hidden="true"></i><span>Digests</span></button>
      </nav>

      <nav class="secondary-nav" aria-label="Support navigation">
        <a class="nav-item" href="#preferences"><i class="ph ph-gear" aria-hidden="true"></i><span>Settings</span></a>
        <a class="nav-item" href="https://github.com/v12labs-engineering/trendtalks" target="_blank" rel="noreferrer"><i class="ph ph-question" aria-hidden="true"></i><span>Help center</span></a>
      </nav>

      <section class="sidebar-note" aria-labelledby="sidebar-note-title">
        <i class="ph ph-chart-line-up" aria-hidden="true"></i>
        <h2 id="sidebar-note-title">Spot what’s next</h2>
        <p>Surface emerging technologies before they become mainstream.</p>
        <a href="#feed">Browse signals <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </section>
    </aside>

    <main class="workspace" id="discover">
      <header class="topbar">
        <label class="search-control" for="repository-search">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <span class="sr-only">Search repositories, topics, or technologies</span>
          <input id="repository-search" type="search" placeholder="Search repositories, topics, technologies…" autocomplete="off">
          <kbd>⌘ K</kbd>
        </label>

        <div class="topbar-controls">
          <button class="control control--date" type="button" aria-label="Discovery date"><i class="ph ph-calendar-blank" aria-hidden="true"></i><span>Aug 21, 2026</span></button>
          <label class="control" for="period-filter"><span class="sr-only">Time range</span><select id="period-filter"><option value="7">Last 7 days</option><option value="1">Today</option><option value="30">Last 30 days</option></select><i class="ph ph-caret-down" aria-hidden="true"></i></label>
          <label class="control" for="language-filter"><span class="sr-only">Language</span><select id="language-filter"><option value="all">All languages</option></select><i class="ph ph-caret-down" aria-hidden="true"></i></label>
          <button class="icon-button" type="button" aria-label="Notifications"><i class="ph ph-bell" aria-hidden="true"></i></button>
          <button class="profile-control" type="button" aria-haspopup="menu"><span class="avatar">V</span><span>V12 Analyst</span><i class="ph ph-caret-down" aria-hidden="true"></i></button>
        </div>
      </header>

      <% if (demoMode) { %>
        <div class="demo-banner" role="status"><i class="ph ph-flask" aria-hidden="true"></i><span>Local demo mode · synthetic data · no production services</span></div>
      <% } %>

      <section class="feed-panel panel" id="feed" aria-labelledby="feed-title">
        <header class="panel-heading">
          <div><h1 id="feed-title">Repository feed</h1><p>Ranked by conversation velocity <i class="ph ph-info" aria-hidden="true"></i></p></div>
          <span class="result-count" data-result-count><%= repos.length %> signals</span>
        </header>
        <div class="feed-table" role="table" aria-label="Trending repository feed">
          <div class="feed-row feed-row--header" role="row">
            <span role="columnheader">#</span><span role="columnheader">Repository</span><span role="columnheader">Source</span><span role="columnheader">Language</span><span role="columnheader">Stars</span><span role="columnheader">Velocity</span><span role="columnheader">Forks</span><span role="columnheader">Conversations</span><span role="columnheader"><span class="sr-only">Actions</span></span>
          </div>
          <div data-feed-list aria-live="polite"></div>
        </div>
        <div class="empty-state" data-empty-state hidden>
          <i class="ph ph-binoculars" aria-hidden="true"></i><h2>No matching signals</h2><p>Try another repository, topic, or language.</p><button class="button button--secondary" type="button" data-clear-filters>Clear filters</button>
        </div>
      </section>

      <div class="content-grid">
        <section class="detail-panel panel" aria-labelledby="detail-title">
          <header class="detail-header">
            <div class="repository-heading">
              <span class="repo-mark"><i class="ph-fill ph-github-logo" aria-hidden="true"></i></span>
              <div><div class="title-line"><h2 id="detail-title" data-detail-name>Repository</h2><a data-detail-link href="#" target="_blank" rel="noreferrer" aria-label="Open repository on GitHub"><i class="ph ph-arrow-square-out" aria-hidden="true"></i></a></div><p data-detail-description></p></div>
            </div>
            <button class="button button--watch" type="button" data-watch-button><i class="ph ph-star" aria-hidden="true"></i><span>Watch repository</span></button>
          </header>

          <div class="repository-meta" data-detail-meta></div>

          <div class="tabs" role="tablist" aria-label="Repository conversation sources">
            <button role="tab" aria-selected="true" data-tab="overview">Overview</button>
            <button role="tab" aria-selected="false" data-tab="hackernews">Hacker News</button>
            <button role="tab" aria-selected="false" data-tab="reddit">Reddit</button>
            <button role="tab" aria-selected="false" data-tab="stackoverflow">Stack Overflow</button>
          </div>

          <div class="detail-body" data-detail-body aria-live="polite"></div>
        </section>

        <aside class="signals-panel panel" aria-labelledby="signals-title">
          <header class="panel-heading"><div><h2 id="signals-title">Trending signals</h2><p>Highest conversation velocity</p></div></header>
          <ol class="signal-list" data-signal-list></ol>
          <a class="text-link" href="#feed">View all trending <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </aside>
      </div>
    </main>
  </div>

  <div class="toast" data-toast role="status" aria-live="polite" hidden></div>
  <script>window.__TREND_TALKS__ = { repos: <%- serializedRepos %>, demoMode: <%= demoMode ? "true" : "false" %> };</script>
  <script src="/js/index.js" defer></script>
</body>
</html>
